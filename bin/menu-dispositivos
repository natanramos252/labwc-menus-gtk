#!/usr/bin/env python3
"""Pendrives e cartões na barra (labwc), como a extensão "drive-menu" do GNOME.

  menu-dispositivos estado  -> JSON para o ícone da barra (some sem dispositivo)
  menu-dispositivos         -> painel com Abrir e Ejetar, no visual dos menus
Fecha ao clicar de novo no ícone, ao clicar em outra janela ou com Esc.
"""
import json
import os
import subprocess
import sys
import time

APP_ID = "org.labwc.MenuDispositivos"
TITULO = "Dispositivos"  # usado na regra de janela do rc.xml


def rodar(*cmd):
    """Executa um comando e devolve (código de saída, texto)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20,
                           env=dict(os.environ, LC_ALL="C"))
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def dispositivos():
    """Discos removíveis com ao menos uma partição montada."""
    _, saida = rodar("lsblk", "-J", "-b", "-o", "PATH,NAME,LABEL,MOUNTPOINT,HOTPLUG,RM,TYPE,SIZE,MODEL,VENDOR,TRAN")
    try:
        arvore = json.loads(saida)["blockdevices"]
    except (ValueError, KeyError):
        return []
    lista = []
    for disco in arvore:
        if disco.get("type") != "disk" or not (disco.get("hotplug") or disco.get("rm")):
            continue
        partes = [p for p in (disco.get("children") or []) + [disco] if p.get("mountpoint")]
        if not partes:
            continue
        nome = (partes[0].get("label") or " ".join(x for x in (disco.get("vendor"), disco.get("model")) if x)
                or "Dispositivo removível").strip()
        gb = int(disco.get("size") or 0) / 1e9
        tipo = "Cartão de memória" if (disco.get("name") or "").startswith("mmc") else "Pendrive"
        lista.append({"disco": disco["path"], "nome": nome, "tamanho": f"{gb:.1f} GB" if gb < 100 else f"{gb:.0f} GB",
                      "tipo": tipo, "partes": [(p["path"], p["mountpoint"]) for p in partes]})
    return lista


def estado():
    """Imprime o JSON do ícone da barra: ícone USB com dica, ou vazio (some) sem dispositivo."""
    lista = dispositivos()
    if not lista:
        print(json.dumps({"text": "", "class": "vazio"}))
        return
    dica = "\n".join(f"{d['nome']} ({d['tamanho']})" for d in lista) + "\nClique para abrir ou ejetar"
    print(json.dumps({"text": "", "class": "conectado", "tooltip": dica}))


def ejetar(d):
    """Desmonta todas as partições do dispositivo e o desliga (como o 'ejetar' do GNOME)."""
    for parte, _ponto in d["partes"]:
        cod, msg = rodar("udisksctl", "unmount", "-b", parte)
        if cod != 0:
            if "busy" in msg.lower() or "target is busy" in msg.lower():
                return False, "Está em uso: feche os arquivos e janelas abertos nele e tente de novo."
            return False, msg.splitlines()[-1] if msg else "Não foi possível desmontar."
    rodar("udisksctl", "power-off", "-b", d["disco"])
    return True, ""


def painel():
    """Abre o painel com os dispositivos conectados (GTK é importado só aqui,
    para o modo 'estado' da barra ficar leve).
    """
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gio, GLib, Gtk

    GLib.set_prgname(APP_ID)
    fechado = os.path.join(GLib.get_user_runtime_dir(), "menu-dispositivos.closed")
    teste = os.environ.get("MENU_TESTE")
    css = b"""
    window.menu-dispositivos { background-color: transparent; }
    #menu { background-color: rgba(24,24,34,0.985); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px; padding: 10px; }
    #menu, #menu label, #menu image { color: #e6e6e6; }
    #menu .dim { color: #9a9aa8; font-size: 12px; }
    #menu .erro { color: #f7768e; font-size: 12px; }
    #menu .titulo { font-weight: bold; }
    #menu .item { background-color: rgba(255,255,255,0.05); border-radius: 10px; padding: 8px 10px; }
    #menu button { background: rgba(255,255,255,0.08); border: none; box-shadow: none;
                   border-radius: 8px; padding: 4px 10px; color: #e6e6e6; }
    #menu button:hover { background: rgba(255,255,255,0.15); }
    """

    class Painel(Gtk.Application):
        """Janela do painel de dispositivos removíveis."""
        def __init__(self):
            """Prepara o app de instância única."""
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.win = None

        def do_activate(self):
            """Abre o painel; se já estiver aberto, fecha."""
            if self.win is not None:
                self.fechar()
                return
            try:
                if time.time() - os.path.getmtime(fechado) < 0.4:
                    self.quit()
                    return
            except OSError:
                pass
            self.construir()

        def fechar(self, marcar=False):
            """Fecha o painel e pede à barra para atualizar o ícone."""
            if marcar:
                open(fechado, "w").close()
            if self.win is not None:
                self.win.destroy()
                self.win = None
            subprocess.Popen(["pkill", "-RTMIN+11", "waybar"])
            self.quit()

        def construir(self):
            """Monta a janela sem moldura no visual dos menus."""
            prov = Gtk.CssProvider()
            prov.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            win = self.win = Gtk.ApplicationWindow(application=self, title=TITULO)
            win.get_style_context().add_class("menu-dispositivos")
            win.set_decorated(False)
            win.set_resizable(False)
            win.set_app_paintable(True)
            if win.get_screen().get_rgba_visual():
                win.set_visual(win.get_screen().get_rgba_visual())
            self.raiz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            self.raiz.set_name("menu")
            self.raiz.set_size_request(300, -1)
            win.add(self.raiz)
            self.preencher()
            win.connect("key-press-event", lambda _w, ev: ev.keyval == Gdk.KEY_Escape and (self.fechar() or True))
            win.connect("focus-out-event", lambda *a: (not teste) and self.fechar(marcar=True))
            win.show_all()

        def preencher(self, aviso=None, erro=False):
            """(Re)desenha a lista de dispositivos e, se houver, um aviso ou erro."""
            for f in self.raiz.get_children():
                self.raiz.remove(f)
            titulo = Gtk.Label(label="Dispositivos removíveis", xalign=0)
            titulo.get_style_context().add_class("titulo")
            self.raiz.pack_start(titulo, False, False, 0)
            lista = dispositivos()
            if not lista and not aviso:
                vazio = Gtk.Label(label="Nenhum pendrive ou cartão conectado", xalign=0)
                vazio.get_style_context().add_class("dim")
                self.raiz.pack_start(vazio, False, False, 0)
            for d in lista:
                item = Gtk.Box(spacing=10)
                item.get_style_context().add_class("item")
                icone = "media-flash-sd-mmc" if d["tipo"] == "Cartão de memória" else "drive-harddisk-usb"
                img = Gtk.Image.new_from_icon_name(icone, Gtk.IconSize.DND)
                item.pack_start(img, False, False, 0)
                textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                textos.pack_start(Gtk.Label(label=d["nome"], xalign=0), False, False, 0)
                sub = Gtk.Label(label=f"{d['tipo']} · {d['tamanho']}", xalign=0)
                sub.get_style_context().add_class("dim")
                textos.pack_start(sub, False, False, 0)
                item.pack_start(textos, True, True, 0)
                abrir = Gtk.Button.new_from_icon_name("folder-open-symbolic", Gtk.IconSize.BUTTON)
                abrir.set_tooltip_text("Abrir")
                abrir.connect("clicked", lambda _b, p=d["partes"][0][1]: self.abrir(p))
                ejetar_b = Gtk.Button.new_from_icon_name("media-eject-symbolic", Gtk.IconSize.BUTTON)
                ejetar_b.set_tooltip_text("Ejetar com segurança")
                ejetar_b.connect("clicked", lambda _b, dd=d: self.ejetar(dd))
                item.pack_end(ejetar_b, False, False, 0)
                item.pack_end(abrir, False, False, 0)
                self.raiz.pack_start(item, False, False, 0)
            if aviso:
                rot = Gtk.Label(label=aviso, xalign=0)
                rot.set_line_wrap(True)
                rot.set_max_width_chars(38)
                rot.get_style_context().add_class("erro" if erro else "dim")
                self.raiz.pack_start(rot, False, False, 0)
            self.raiz.show_all()

        def abrir(self, ponto):
            """Abre o ponto de montagem no gerenciador de arquivos padrão."""
            subprocess.Popen(["gio", "open", ponto], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.fechar()

        def ejetar(self, d):
            """Botão Ejetar: ejeta, avisa e atualiza a lista (ou mostra o erro, ex.: em uso)."""
            ok, msg = ejetar(d)
            if ok:
                subprocess.Popen(["notify-send", "-a", "Dispositivos", "-i", "media-eject",
                                  f"{d['nome']} pode ser removido", "O dispositivo foi ejetado com segurança."])
                subprocess.Popen(["pkill", "-RTMIN+11", "waybar"])
                if not dispositivos():
                    self.fechar()
                    return
                self.preencher(f"{d['nome']} pode ser removido.")
            else:
                self.preencher(msg, erro=True)

    Painel().run(None)


if __name__ == "__main__":
    if sys.argv[1:] == ["estado"]:
        estado()
    else:
        painel()
