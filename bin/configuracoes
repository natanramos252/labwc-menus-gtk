    "touchpad": {"tap": True, "natural": False, "velocidade": 0.0, "dwt": True, "clique": "buttonAreas"},
    "mouse": {"natural": False, "velocidade": 0.0, "aceleracao": "adaptive"},
    "teclado": {"repeticao": 25, "atraso": 600},
    "energia": {"bloquear": 10, "tela": 0, "suspender": 0},
    "notificacoes": {"nao_perturbe": False, "duracao": 5, "posicao": "top-right"},
}
