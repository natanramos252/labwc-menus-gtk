#!/usr/bin/env python3
"""Configurações para a sessão labwc, no mesmo visual dos menus.

Ajusta na hora o que o labwc controla (mouse, touchpad, teclado, papel de
parede, brilho, volume, tema) e abre a ferramenta certa para o resto
(Wi-Fi, Bluetooth, impressoras, monitores, usuários...).

O que é do labwc fica num bloco marcado do rc.xml, gerado a partir de
~/.config/labwc/configuracoes.json. Teste: CONFIG_PAGINA=<id> abre numa seção.
"""
import json
import os
import platform
import re
import shutil
import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.labwc.Configuracoes"
GLib.set_prgname(APP_ID)
HOME = os.path.expanduser("~")
LABWC = os.path.join(HOME, ".config/labwc")
RC = os.path.join(LABWC, "rc.xml")
ESTADO = os.path.join(LABWC, "configuracoes.json")
AMBIENTE = os.path.join(LABWC, "environment")
AUTOSTART = os.path.join(LABWC, "autostart")
WALLPAPERS = os.path.join(HOME, "Imagens/wallpapers")
INICIO, FIM = "<!-- configuracoes:inicio", "<!-- configuracoes:fim -->"

