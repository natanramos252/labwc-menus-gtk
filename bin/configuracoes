# ---------------------------------------------------------------- utilidades
def rodar(*cmd, env=None):
    """Executa um comando e devolve o resultado (ou None se falhar), sem travar a interface por mais de 10 s."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def abrir(*cmd, gnome=False):
    """Abre um programa separado deste app. Com gnome=True, finge ser o GNOME
    (necessário para o gnome-control-center abrir fora do GNOME).
    """
    env = dict(os.environ)
    if gnome:
        env["XDG_CURRENT_DESKTOP"] = "GNOME"
    try:
        subprocess.Popen(cmd, env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def tem(programa):
    """Diz se um programa está instalado (existe no PATH)."""
    return shutil.which(programa) is not None


def ler_estado():
    """Lê as escolhas salvas (configuracoes.json), completando com os valores padrão."""
    estado = json.loads(json.dumps(PADRAO))
    try:
        salvo = json.load(open(ESTADO))
        for grupo, valores in salvo.items():
            estado.setdefault(grupo, {}).update(valores)
    except (OSError, ValueError):
        pass
    return estado


def sim(v):
    """Converte True/False para o 'yes'/'no' que o rc.xml do labwc espera."""
    return "yes" if v else "no"


def aplicar_labwc(estado):
    """Grava o bloco gerado no rc.xml e recarrega o labwc."""
    json.dump(estado, open(ESTADO, "w"), indent=2)
    t, m, k = estado["touchpad"], estado["mouse"], estado["teclado"]
    bloco = f"""  {INICIO} (gerado pelo app Configurações; não edite à mão) -->
  <keyboard>
    <repeatRate>{int(k['repeticao'])}</repeatRate>
    <repeatDelay>{int(k['atraso'])}</repeatDelay>
  </keyboard>
  <libinput>
    <device category="touchpad">
      <tap>{sim(t['tap'])}</tap>
      <naturalScroll>{sim(t['natural'])}</naturalScroll>
      <pointerSpeed>{t['velocidade']:.2f}</pointerSpeed>
      <disableWhileTyping>{sim(t['dwt'])}</disableWhileTyping>
      <clickMethod>{t['clique']}</clickMethod>
    </device>
    <device category="non-touch">
      <naturalScroll>{sim(m['natural'])}</naturalScroll>
      <pointerSpeed>{m['velocidade']:.2f}</pointerSpeed>
      <accelProfile>{m['aceleracao']}</accelProfile>
    </device>
  </libinput>
  {FIM}
"""
    texto = open(RC).read()
    padrao = re.compile(r"  " + re.escape(INICIO) + r".*?" + re.escape(FIM) + r"\n", re.S)
    if padrao.search(texto):
        texto = padrao.sub(lambda _m: bloco, texto)
    else:
        texto = texto.replace("</labwc_config>", bloco + "</labwc_config>")
    tmp = RC + ".tmp"
    open(tmp, "w").write(texto)
    os.replace(tmp, RC)
    rodar("labwc", "--reconfigure")


def ler_ambiente():
    """Lê ~/.config/labwc/environment (variáveis como o layout do teclado) para um dicionário."""
    linhas = {}
    try:
        for linha in open(AMBIENTE):
            if "=" in linha and not linha.lstrip().startswith("#"):
                chave, valor = linha.rstrip("\n").split("=", 1)
                linhas[chave] = valor
    except OSError:
        pass
    return linhas


def gravar_ambiente(linhas):
    """Grava o dicionário de volta no arquivo environment do labwc (vale no próximo login)."""
    with open(AMBIENTE, "w") as f:
        for chave, valor in linhas.items():
            if valor != "":
                f.write(f"{chave}={valor}\n")


def papel_atual():
    """Descobre no autostart qual imagem está como papel de parede."""
    try:
        m = re.search(r"swaybg -i (\S+)", open(AUTOSTART).read())
        return os.path.expanduser(m.group(1)) if m else None
    except OSError:
        return None


def trocar_papel(caminho):
    """Troca o papel de parede: atualiza o autostart e reinicia o swaybg na hora."""
    texto = open(AUTOSTART).read()
    rel = caminho.replace(HOME, "~", 1)
    texto = re.sub(r"swaybg -i \S+", lambda _m: f"swaybg -i {rel}", texto, count=1)
    open(AUTOSTART, "w").write(texto)
    rodar("pkill", "-x", "swaybg")
    abrir("swaybg", "-i", caminho, "-m", "fill")


# ---------------------------------------------------------------- componentes
def rotulo(texto, classe=None, xalign=0.0, quebra=False):
    """Cria um texto (Gtk.Label) com classe CSS opcional e quebra de linha opcional."""
    lab = Gtk.Label(label=texto, xalign=xalign)
    if quebra:
        lab.set_line_wrap(True)
        lab.set_max_width_chars(60)
    if classe:
        lab.get_style_context().add_class(classe)
    return lab


def cartao(*linhas):
    """Agrupa várias linhas num 'cartão' arredondado com separadores, como no GNOME Settings."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.get_style_context().add_class("cartao")
    for i, linha in enumerate(linhas):
        if i:
            sep = Gtk.Box()
            sep.get_style_context().add_class("sep")
            box.pack_start(sep, False, False, 0)
        box.pack_start(linha, False, False, 0)
    return box


def linha(titulo, widget=None, sub=None):
    """Uma linha de configuração: título (e subtítulo) à esquerda e o controle à direita."""
    box = Gtk.Box(spacing=12)
    box.get_style_context().add_class("linha")
    textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
    textos.pack_start(rotulo(titulo), False, False, 0)
    if sub:
        textos.pack_start(rotulo(sub, "dim", quebra=True), False, False, 0)
    box.pack_start(textos, True, True, 0)
    if widget is not None:
        widget.set_valign(Gtk.Align.CENTER)
        box.pack_end(widget, False, False, 0)
    return box


def chave(ativo, ao_mudar):
    """Cria um interruptor (Gtk.Switch) que chama ao_mudar(True/False) quando muda."""
    s = Gtk.Switch(active=ativo)
    s.connect("notify::active", lambda w, _p: ao_mudar(w.get_active()))
    return s


def deslizante(minimo, maximo, passo, valor, ao_mudar, largura=220, atraso=250):
    """Cria um controle deslizante. Só aplica a mudança depois de 'atraso' ms sem mexer,
    para não gravar arquivos a cada pixel arrastado.
    """
    s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, minimo, maximo, passo)
    s.set_value(valor)
    s.set_draw_value(False)
    s.set_size_request(largura, -1)
    pendente = {"id": 0}

    def mudou(w):
        """Reinicia a contagem do atraso a cada movimento do controle."""
        if pendente["id"]:
            GLib.source_remove(pendente["id"])

        def agora():
            """Aplica o valor depois que o usuário parou de mexer."""
            pendente["id"] = 0
            ao_mudar(w.get_value())
            return False
        pendente["id"] = GLib.timeout_add(atraso, agora)
    s.connect("value-changed", mudou)
    return s


def botao(texto, ao_clicar):
    """Cria um botão que chama ao_clicar() quando clicado."""
    b = Gtk.Button(label=texto)
    b.connect("clicked", lambda _b: ao_clicar())
    return b


